# Liread - Supabase Configuration
# Obtain your project URL and public Anon Key from: https://app.supabase.com/project/_/settings/api
# These credentials are required for real accounts. Without them only Guest mode works.

# Supabase Project URL (e.g. https://xyzcompany.supabase.co)
VITE_SUPABASE_URL=https://your-project-id.supabase.co

# Supabase Public Anon Key (safe to use in browser)
VITE_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.your-anon-key-here

# Telegram Bot PDF Delivery Configuration
# Client-side Telegram Bot username (without @, e.g. LiReadBot)
VITE_TELEGRAM_BOT_USERNAME=LiReadBot
NEXT_PUBLIC_TELEGRAM_BOT_USERNAME=LiReadBot

# Server-side Telegram Bot Credentials (used by serverless /api/telegram webhook)
# Configure these in your Vercel Project Settings > Environment Variables:
TELEGRAM_BOT_TOKEN=123456789:ABCdefGHIjklMNOpqrSTUvwxYZ
TELEGRAM_VAULT_CHANNEL_ID=-1001234567890
